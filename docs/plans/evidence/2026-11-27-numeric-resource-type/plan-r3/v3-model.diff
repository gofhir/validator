+package slicematch
+
+import "github.com/gofhir/validator/v2/pkg/registry"
+
+func IsResource(value map[string]any) bool { _, ok := value["resourceType"].(string); return ok }
+func ResourceAt(reg *registry.Registry, sd *registry.StructureDefinition, def *registry.ElementDefinition, value map[string]any) bool {
+	if !IsResource(value) || def == nil {
+		return false
+	}
+	if reg.HoldsResource(def) {
+		return true
+	}
+	return sd != nil && sd.Kind == registry.KindResource && sd.Tree() != nil && sd.Tree().Root().Def == def
+}
