      ],
      "hl7": [
        "Validation_VAL_Profile_SliceOrder"
      ]
    },
    {
      "name": "slicing-cannot-be-evaluated",
      "rule": "equal",
      "gofhir": [
        "SLICING_CANNOT_BE_EVALUATED"
      ],
      "hl7": [
        "SLICING_CANNOT_BE_EVALUATED"
      ]
    },
    {
